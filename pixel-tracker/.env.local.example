# Optional — leave empty to run the app without Redis (in-memory fallback for dev only)
UPSTASH_REDIS_REST_URL=your_url
UPSTASH_REDIS_REST_TOKEN=your_token

# Optional — fire-and-forget POST of every event
WEBHOOK_URL=

# Optional — Basic Auth on the dashboard, /api/logs, and /api/stats.
# Leave DASHBOARD_PASSWORD blank to disable auth entirely.
# /api/track and /api/click stay public so pixels and link-redirects keep working.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
