# -----------------------------------------------------------------------------
# Agentic Email Automation — Central Configuration File template
# Copy this file to '.env' and fill in your real credentials.
# -----------------------------------------------------------------------------

# Next.js Serverless Tracker
# Example: https://your-vercel-pixel-tracker.vercel.app
TRACKER_BASE_URL=http://localhost:3000
DASHBOARD_PASSWORD=your_dashboard_basic_auth_password_if_set

# Outbox Gmail Credentials
# Create an App Password in your Google Account Security settings
GMAIL_ADDRESS=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Google Gemini API Key
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Daily Sending Limits & Delays
DAILY_SEND_LIMIT=50
SEND_DELAY_MIN=3
SEND_DELAY_MAX=8
